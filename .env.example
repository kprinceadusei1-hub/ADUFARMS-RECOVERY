# ADUFARMS environment configuration — copy to .env and fill real values. Never commit .env.
ADUFARMS_SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_PATH=
ADUFARMS_COOKIE_SECURE=0
ADUFARMS_DEBUG=0
# Stock level (KG) at or below which "low stock" alerts appear
ADUFARMS_LOW_STOCK_KG=1000
# Email for password reset links (Gmail App Password, not your normal password)
ADUFARMS_SMTP_USERNAME=
ADUFARMS_SMTP_PASSWORD=
# Public address of the app, used inside reset/verification email links
ADUFARMS_PUBLIC_URL=http://127.0.0.1:5000
# Set to 1 only when behind a reverse proxy you control
ADUFARMS_TRUST_PROXY=0
